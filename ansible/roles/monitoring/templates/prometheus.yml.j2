global:
  scrape_interval: 15s

scrape_configs:
  - job_name: 'prometheus'
    static_configs:
      - targets: ['localhost:9090']

  - job_name: 'node_exporter'
    static_configs:
      - targets:
{% for host in groups['all'] %}
        - '{{ hostvars[host].ansible_host | default(host) }}:9100'
{% endfor %}

  - job_name: 'rabbitmq'
    metrics_path: '/metrics'
    static_configs:
      - targets:
{% for host in groups['host'] %}
        - '{{ hostvars[host].ansible_host | default(host) }}:15692'
{% endfor %}
