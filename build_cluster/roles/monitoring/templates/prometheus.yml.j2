global:
  scrape_interval: 15s

scrape_configs:
  - job_name: 'prometheus'
    static_configs:
      - targets: ['localhost:9090']

  # 监控所有节点的物理资源 (CPU/内存)
  - job_name: 'node_exporter'
    static_configs:
      - targets:
{% for host in groups['all'] %}
        - '{{ hostvars[host].ansible_host | default(host) }}:9100'
{% endfor %}

  # 新增: 监控 RabbitMQ (队列长度/消息速率)
  # RabbitMQ Management 插件默认在 15672 端口暴露 /metrics
  - job_name: 'rabbitmq'
    metrics_path: '/metrics'
    static_configs:
      - targets:
{% for host in groups['host'] %}
        - '{{ hostvars[host].ansible_host | default(host) }}:15672'
{% endfor %}
