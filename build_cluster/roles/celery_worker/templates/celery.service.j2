[Unit]
Description=Celery Service
After=network.target

[Service]
Type=forking
User=root
Group=root
EnvironmentFile=-/etc/conf.d/celery
WorkingDirectory=/opt/calc_engine

# 核心修正：
# 1. 增加了 -c ${CELERYD_CONCURRENCY}，确保读取到 "3" 这个配置
# 2. 保持在一行内
ExecStart=/bin/sh -c '${CELERY_BIN} -A $CELERY_APP multi start $CELERYD_NODES -c ${CELERYD_CONCURRENCY} --pidfile=${CELERYD_PID_FILE} --logfile=${CELERYD_LOG_FILE} --loglevel=${CELERYD_LOG_LEVEL} $CELERYD_OPTS'

# 停止命令不需要并发参数
ExecStop=/bin/sh -c '${CELERY_BIN} multi stopwait $CELERYD_NODES --pidfile=${CELERYD_PID_FILE} --loglevel=${CELERYD_LOG_LEVEL}'

# 重启命令也加上并发参数
ExecReload=/bin/sh -c '${CELERY_BIN} multi restart $CELERYD_NODES -c ${CELERYD_CONCURRENCY} --pidfile=${CELERYD_PID_FILE} --logfile=${CELERYD_LOG_LEVEL} $CELERYD_OPTS'

Restart=always

[Install]
WantedBy=multi-user.target
